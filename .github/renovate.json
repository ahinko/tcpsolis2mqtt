{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": true,
  "timezone": "Europe/Stockholm",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "🤖 Renovate Dashboard",
  "suppressNotifications": [
    "prIgnoreNotification"
  ],
  "rebaseWhen": "conflicted",
  "assignees": [
    "@ahinko"
  ],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "Python is declared once, in the Dockerfile, and CI reads the version out of it. There is nothing to group with it and no custom manager: two copies meant two dependencies with different constraints, and Renovate moved one without the other. ruff.toml still repeats it as py<major><minor>, which is not a shape Renovate can rewrite, so tests/test_python_version.py fails if that is left behind.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python"
      ],
      "labels": [
        "renovate/docker",
        "dependency/python"
      ]
    },
    {
      "matchDatasources": [
        "docker",
        "pypi"
      ],
      "enabled": true,
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "renovate/docker",
        "dependency/major"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "labels": [
        "renovate/docker",
        "dependency/minor"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "labels": [
        "renovate/docker",
        "dependency/patch"
      ]
    },
    {
      "matchDatasources": [
        "pypi"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "renovate/pypi",
        "dependency/major"
      ]
    },
    {
      "matchDatasources": [
        "pypi"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "labels": [
        "renovate/pypi",
        "dependency/minor"
      ]
    },
    {
      "matchDatasources": [
        "pypi"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "labels": [
        "renovate/pypi",
        "dependency/patch"
      ]
    }
  ]
}
