{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": true,
  "timezone": "Europe/Stockholm",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "🤖 Renovate Dashboard",
  "suppressNotifications": [
    "prIgnoreNotification"
  ],
  "rebaseWhen": "conflicted",
  "assignees": [
    "@ahinko"
  ],
  "semanticCommits": "enabled",
  "customManagers": [
    {
      "customType": "regex",
      "description": "ruff.toml repeats the Dockerfile's Python as py<major><minor>. Read it back as <major>.<minor>, track the two-part python tag that is published alongside every release, and write it back without the dot. Same depName and major as the Dockerfile, so both land on the same renovate/python-3.x branch.",
      "managerFilePatterns": [
        "/^ruff\\.toml$/"
      ],
      "matchStrings": [
        "target-version\\s*=\\s*\"py(?<major>\\d)(?<minor>\\d+)\""
      ],
      "currentValueTemplate": "{{{major}}}.{{{minor}}}",
      "datasourceTemplate": "docker",
      "depNameTemplate": "python",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "target-version = \"py{{{replace '[.]' '' newValue}}}\""
    }
  ],
  "packageRules": [
    {
      "description": "Python is declared in the Dockerfile, and CI reads the version out of it. ruff.toml repeats it as py<major><minor>, kept in step by the custom manager above; tests/test_python_version.py still fails if the two ever disagree.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python"
      ],
      "labels": [
        "renovate/docker",
        "dependency/python"
      ]
    },
    {
      "description": "The Dockerfile pins python:<version>-alpine3.<minor>. Default docker versioning treats the alpine suffix as a compatibility constraint and never leaves it, which froze the image at 3.14.5 when 3.14.6 was only published for the next alpine. Here the alpine minor is the build number, so python and alpine move together to the newest tag. Only the dockerfile manager: the ruff.toml manager tracks the bare two-part tag and keeps docker versioning. tests/test_python_version.py checks the Dockerfile tag against this pattern.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-alpine3\\.(?<build>\\d+)$"
    },
    {
      "matchDatasources": [
        "docker",
        "pypi"
      ],
      "enabled": true,
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "renovate/docker",
        "dependency/major"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "labels": [
        "renovate/docker",
        "dependency/minor"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "labels": [
        "renovate/docker",
        "dependency/patch"
      ]
    },
    {
      "matchDatasources": [
        "pypi"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "renovate/pypi",
        "dependency/major"
      ]
    },
    {
      "matchDatasources": [
        "pypi"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "labels": [
        "renovate/pypi",
        "dependency/minor"
      ]
    },
    {
      "matchDatasources": [
        "pypi"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "labels": [
        "renovate/pypi",
        "dependency/patch"
      ]
    }
  ]
}
